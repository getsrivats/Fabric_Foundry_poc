/// Direct Lake semantic model for D6 Customer Support & Case Analytics. Facts and conformed dimensions from the Gold warehouse; ratio/derived KPIs implemented as measures.
model SM_customer_support
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3

ref table fact_service_case
ref table fact_osd_claim
ref table fact_call_interaction
ref table fact_agent_daily
ref table fact_survey_response
ref table fact_csi_nps_snapshot
ref table dim_agent
ref table dim_survey_type
ref table dim_issue_category
ref table dim_date
ref table dim_dealer
ref table dim_machine
