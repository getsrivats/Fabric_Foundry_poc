/// Relates dim_machine to fact_service_case on machine_pin.
relationship rel_fact_service_case_machine_pin
	fromColumn: fact_service_case.machine_pin
	toColumn: dim_machine.machine_pin
	crossFilteringBehavior: oneDirection
	isActive: true

