	toColumn: dim_date.date_key
	crossFilteringBehavior: oneDirection
	isActive: true

/// Relates dim_date to fact_service_case on closed_date_key. Inactive role-playing date relationship (activate with USERELATIONSHIP in measures).
relationship rel_fact_service_case_closed_date_key
	fromColumn: fact_service_case.closed_date_key
	toColumn: dim_date.date_key
	crossFilteringBehavior: oneDirection
	isActive: false

