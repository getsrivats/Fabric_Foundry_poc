/// Direct Lake semantic model for D9 Field Service / Dealer Service KPIs. Facts and conformed dimensions from the Gold warehouse; ratio/derived KPIs implemented as measures.
model SM_field_service
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3

ref table dim_service_campaign
ref table fact_service_campaign_member
ref table fact_work_order
ref table fact_wo_part_labor
ref table dim_date
ref table dim_dealer
