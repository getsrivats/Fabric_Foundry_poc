/// DIM - dim_date. Grain: One row per calendar day.
table dim_date
	/// Primary/surrogate key. CAST(CONVERT(VARCHAR(8), d.[Date], 112) AS INT)
	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	/// d.[Date]
	column date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date

	/// d.DayOfWeek
	column day_of_week
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_week

	/// d.DayNameShort
	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name

	/// d.IsWeekend
	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	/// d.IsHoliday
	column is_holiday
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_holiday

	/// CASE WHEN d.IsWeekendOrHoliday = 0 THEN 1 ELSE 0 END
	column is_business_day
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_business_day

	/// d.MonthNum
	column month_num
		dataType: int64
		summarizeBy: none
		sourceColumn: month_num

	/// d.MonthNameShort
	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name

	/// d.QuarterNum
	column quarter_num
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter_num

	/// d.QuarterShort
	column quarter_name
		dataType: string
		summarizeBy: none
		sourceColumn: quarter_name

	/// d.YearNum
	column year_num
		dataType: int64
		summarizeBy: none
		sourceColumn: year_num

	/// d.WeekNumber
	column week_number
		dataType: int64
		summarizeBy: none
		sourceColumn: week_number

	/// d.WeekEndingDate
	column week_ending_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: week_ending_date

	/// d.PreviousBusinessDate
	column previous_business_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: previous_business_date

	/// d.IfNotBusinessDayThenNextBusinessDateElseCurrentDate
	column next_business_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: next_business_date

	/// d.IsYTD
	column is_ytd
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_ytd

	/// d.IsThisYear
	column is_this_year
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_this_year

	/// d.IsLastYear
	column is_last_year
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_last_year

	/// d.SmartSupply_WklyPeriod
	column smart_supply_wkly_period
		dataType: string
		summarizeBy: none
		sourceColumn: smart_supply_wkly_period

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: conformed
			expressionSource: GoldSqlEndpoint
