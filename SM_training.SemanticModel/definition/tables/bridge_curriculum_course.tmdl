/// DIM - dim_course / dim_curriculum + bridge. Grain: One row per course / per curriculum / per curriculum-course pair.
table bridge_curriculum_course
	/// Primary/surrogate key.
	column curriculum_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: curriculum_key

	/// Foreign key to a dimension.
	column course_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: course_key

	/// Sequence attribute.
	column sequence
		dataType: int64
		summarizeBy: none
		sourceColumn: sequence

	partition bridge_curriculum_course = entity
		mode: directLake
		source
			entityName: bridge_curriculum_course
			schemaName: training
			expressionSource: GoldSqlEndpoint
