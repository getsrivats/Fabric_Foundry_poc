/// FACT - fact_fill_rate. Grain: One row per sales order line per reporting date (snapshot).
table fact_fill_rate
	/// Primary/surrogate key. CAST(CONVERT(VARCHAR(8), fr.REPORTING_DATE, 112) AS INT)
	column reporting_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: reporting_date_key

	/// fr.SALES_ORDER
	column sales_order
		dataType: string
		summarizeBy: none
		sourceColumn: sales_order

	/// fr.SO_ITEM
	column so_item
		dataType: int64
		summarizeBy: none
		sourceColumn: so_item

	/// Foreign key to dimension. CAST(CONVERT(VARCHAR(8), fr.ORDER_DATE, 112) AS INT)
	column order_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: order_date_key

	/// fr.SCHEDULE_DATE
	column schedule_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: schedule_date

	/// fr.DELIVERY_DATE
	column delivery_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: delivery_date

	/// fr.DEALER
	column dealer_code
		dataType: string
		summarizeBy: none
		sourceColumn: dealer_code

	/// fr.MATERIAL
	column material
		dataType: string
		summarizeBy: none
		sourceColumn: material

	/// fr.SHIPPING_PLANT
	column shipping_plant
		dataType: string
		summarizeBy: none
		sourceColumn: shipping_plant

	/// fr.FACING_PLANT
	column facing_plant
		dataType: string
		summarizeBy: none
		sourceColumn: facing_plant

	/// fr.ORDER_TYPE
	column order_type
		dataType: string
		summarizeBy: none
		sourceColumn: order_type

	/// fr.ITEM_CATEGORY
	column item_category
		dataType: string
		summarizeBy: none
		sourceColumn: item_category

	/// fr.PURCHASE_GRP
	column purch_grp
		dataType: string
		summarizeBy: none
		sourceColumn: purch_grp

	/// fr.VENDOR
	column vendor_code
		dataType: string
		summarizeBy: none
		sourceColumn: vendor_code

	/// fr.ABC_IND
	column abc_indicator
		dataType: string
		summarizeBy: none
		sourceColumn: abc_indicator

	/// fr.ORDER_QTY
	column order_qty
		dataType: decimal
		summarizeBy: none
		sourceColumn: order_qty

	/// fr.CONFIRMED_QTY
	column confirmed_qty
		dataType: decimal
		summarizeBy: none
		sourceColumn: confirmed_qty

	/// fr.ORDER_QTY - fr.CONFIRMED_QTY
	column fill_loss_qty
		dataType: decimal
		summarizeBy: none
		sourceColumn: fill_loss_qty

	/// fr.FILL_STATUS
	column fill_status
		dataType: string
		summarizeBy: none
		sourceColumn: fill_status

	/// Number of rows (records) in fact_fill_rate.
	measure 'fact_fill_rate Row Count' = COUNTROWS(fact_fill_rate)
		formatString: #,0

	/// Sum of order qty across the current filter context.
	measure 'Total Order Qty' = SUM(fact_fill_rate[order_qty])
		formatString: #,0.00

	/// Sum of confirmed qty across the current filter context.
	measure 'Total Confirmed Qty' = SUM(fact_fill_rate[confirmed_qty])
		formatString: #,0.00

	/// Sum of fill loss qty across the current filter context.
	measure 'Total Fill Loss Qty' = SUM(fact_fill_rate[fill_loss_qty])
		formatString: #,0.00

	partition fact_fill_rate = entity
		mode: directLake
		source
			entityName: fact_fill_rate
			schemaName: order_fulfillment
			expressionSource: GoldSqlEndpoint
