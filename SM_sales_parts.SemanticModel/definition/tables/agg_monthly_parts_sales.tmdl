/// AGG - agg_monthly_parts_sales. Grain: One row per month per (latest) material.
table agg_monthly_parts_sales
	/// Primary/surrogate key. f.invoice_date_key / 100
	column month_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_key

	/// COALESCE(s.latest_part, f.material)
	column latest_part
		dataType: string
		summarizeBy: none
		sourceColumn: latest_part

	/// MAX(m.material_group)
	column material_group
		dataType: string
		summarizeBy: none
		sourceColumn: material_group

	/// SUM(f.qty)
	column qty
		dataType: decimal
		summarizeBy: none
		sourceColumn: qty

	/// SUM(f.dnet_amt)
	column ttl_dnet
		dataType: decimal
		summarizeBy: none
		sourceColumn: ttl_dnet

	/// SUM(f.list_price_amt)
	column ttl_list
		dataType: decimal
		summarizeBy: none
		sourceColumn: ttl_list

	/// SUM(f.invoice_amt)
	column invoice_amt
		dataType: decimal
		summarizeBy: none
		sourceColumn: invoice_amt

	/// COUNT(DISTINCT f.sales_order)
	column order_count
		dataType: int64
		summarizeBy: none
		sourceColumn: order_count

	/// Number of rows (records) in agg_monthly_parts_sales.
	measure 'agg_monthly_parts_sales Row Count' = COUNTROWS(agg_monthly_parts_sales)
		formatString: #,0

	/// Sum of qty across the current filter context.
	measure 'Total Qty' = SUM(agg_monthly_parts_sales[qty])
		formatString: #,0.00

	/// Sum of ttl dnet across the current filter context.
	measure 'Total Ttl Dnet' = SUM(agg_monthly_parts_sales[ttl_dnet])
		formatString: #,0.00

	/// Sum of invoice amt across the current filter context.
	measure 'Total Invoice Amt' = SUM(agg_monthly_parts_sales[invoice_amt])
		formatString: #,0.00

	/// Sum of order count across the current filter context.
	measure 'Total Order Count' = SUM(agg_monthly_parts_sales[order_count])
		formatString: #,0

	partition agg_monthly_parts_sales = entity
		mode: directLake
		source
			entityName: agg_monthly_parts_sales
			schemaName: sales_parts
			expressionSource: GoldSqlEndpoint
