/// FACT - fact_sales_orders. Grain: One row per sales order line.
table fact_sales_orders
	/// Primary/surrogate key. a.VBELN
	column sales_order
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: sales_order

	/// p.POSNR
	column so_item
		dataType: int64
		summarizeBy: none
		sourceColumn: so_item

	/// Foreign key to dimension. CAST(CONVERT(VARCHAR(8), a.ERDAT, 112) AS INT)
	column order_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: order_date_key

	/// TRIM(LEADING '0' FROM a.KUNNR)
	column dealer_code
		dataType: string
		summarizeBy: none
		sourceColumn: dealer_code

	/// p.MATNR
	column material
		dataType: string
		summarizeBy: none
		sourceColumn: material

	/// p.WERKS
	column plant
		dataType: string
		summarizeBy: none
		sourceColumn: plant

	/// a.AUART
	column order_type
		dataType: string
		summarizeBy: none
		sourceColumn: order_type

	/// p.PSTYV
	column item_category
		dataType: string
		summarizeBy: none
		sourceColumn: item_category

	/// p.KWMENG
	column order_qty
		dataType: decimal
		summarizeBy: none
		sourceColumn: order_qty

	/// p.KBMENG
	column confirmed_qty
		dataType: decimal
		summarizeBy: none
		sourceColumn: confirmed_qty

	/// p.NETWR
	column net_value
		dataType: decimal
		summarizeBy: none
		sourceColumn: net_value

	/// p.ABGRU
	column rejection_reason
		dataType: string
		summarizeBy: none
		sourceColumn: rejection_reason

	/// CASE WHEN p.ABGRU = '' AND p.KWMENG > COALESCE((SELECT SUM(f.RFMNG) FROM LH_Silver.stg_s4.VBFA f WHERE f.VBELV = a.VB...
	column is_open
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_open

	/// Number of rows (records) in fact_sales_orders.
	measure 'fact_sales_orders Row Count' = COUNTROWS(fact_sales_orders)
		formatString: #,0

	/// Sum of order qty across the current filter context.
	measure 'Total Order Qty' = SUM(fact_sales_orders[order_qty])
		formatString: #,0.00

	/// Sum of confirmed qty across the current filter context.
	measure 'Total Confirmed Qty' = SUM(fact_sales_orders[confirmed_qty])
		formatString: #,0.00

	/// Sum of net value across the current filter context.
	measure 'Total Net Value' = SUM(fact_sales_orders[net_value])
		formatString: #,0.00

	partition fact_sales_orders = entity
		mode: directLake
		source
			entityName: fact_sales_orders
			schemaName: sales_parts
			expressionSource: GoldSqlEndpoint
